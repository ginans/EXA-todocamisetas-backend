{
  "info": {
    "name": "TodoCamisetas API",
    "description": "Coleccion base para consumir la API de TodoCamisetas.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Camisetas",
      "item": [
        {
          "name": "Listar camisetas",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/v1/camisetas"
          }
        },
        {
          "name": "Crear camiseta",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"titulo\": \"Camiseta Local 2025 - Seleccion Chilena\",\n  \"club\": \"Seleccion Chilena\",\n  \"pais\": \"Chile\",\n  \"tipo\": \"Local\",\n  \"color\": \"Rojo\",\n  \"precio\": 45000,\n  \"precio_oferta\": 42000,\n  \"detalles\": \"Edicion aniversario\",\n  \"codigo_producto\": \"SCL2025L\"\n}"
            },
            "url": "{{baseUrl}}/api/v1/camisetas"
          }
        },
        {
          "name": "Obtener camiseta por id",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/v1/camisetas/1"
          }
        },
        {
          "name": "Precio final por cliente",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/v1/camisetas/1/precio-final?cliente_id=1"
          }
        },
        {
          "name": "Actualizar camiseta",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"precio\": 47000,\n  \"precio_oferta\": 43000\n}"
            },
            "url": "{{baseUrl}}/api/v1/camisetas/1"
          }
        },
        {
          "name": "Eliminar camiseta",
          "request": {
            "method": "DELETE",
            "url": "{{baseUrl}}/api/v1/camisetas/1"
          }
        }
      ]
    },
